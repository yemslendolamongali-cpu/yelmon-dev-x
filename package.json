{
  "name": "yelmon-dev-x",
  "version": "1.0.0",
  "description": "YELMON Dev X - Assistant de codage IA nouvelle génération",
  "main": "frontend/src/main.js",
  "author": "YELMON Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && python app.py",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && pip install -r requirements.txt",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "concurrently": "^8.0.0"
  },
  "build": {
    "appId": "com.yelmon.devx",
    "productName": "YELMON Dev X",
    "directories": {
      "output": "dist"
    },
    "files": [
      "frontend/build/**/*",
      "frontend/src/main.js",
      "frontend/src/preload.js",
      "backend/**/*",
      "!backend/venv/**/*",
      "!**/node_modules/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/header.bmp",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "backend/",
        "to": "backend/",
        "filter": [
          "**/*",
          "!venv/**/*",
          "!__pycache__/**/*"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@25.9.8": true
  }
}
